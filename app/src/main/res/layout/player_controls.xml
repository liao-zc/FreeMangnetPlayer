<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/exo_controller" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageButton android:id="@+id/player_favorite" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="收藏视频" android:src="@drawable/ic_heart_outline"/>

<LinearLayout android:id="@+id/exo_bottom_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="#B8000000" android:paddingHorizontal="4dp" android:paddingBottom="4dp">
<TextView android:id="@+id/player_resource_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:padding="4dp"/>

<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/player_position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:minWidth="40dp" android:gravity="center" android:text="00:00"/>
<FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"><androidx.media3.ui.DefaultTimeBar android:id="@+id/player_progress" android:layout_width="match_parent" android:layout_height="48dp" android:importantForAccessibility="yes" android:contentDescription="视频进度，可拖动快进或后退" app:played_color="#29CEC0" app:scrubber_color="#FFFFFF" app:buffered_color="#88FFFFFF" app:touch_target_height="48dp"/><com.omniplayer.magnet.CacheCoverageView android:id="@+id/player_cache_coverage" android:layout_width="match_parent" android:layout_height="5dp" android:layout_gravity="bottom" android:layout_marginHorizontal="8dp" android:layout_marginBottom="8dp" android:importantForAccessibility="no" android:contentDescription="已缓存区间"/></FrameLayout>
<TextView android:id="@+id/player_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:minWidth="40dp" android:gravity="center" android:text="00:00"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
<ImageButton android:id="@+id/exo_rew" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="后退 15 秒" android:src="@drawable/exo_icon_rewind"/><ImageButton android:id="@+id/exo_play_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="播放/暂停" android:src="@drawable/exo_icon_play"/><ImageButton android:id="@+id/exo_ffwd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="前进 15 秒" android:src="@drawable/exo_icon_fastforward"/><ImageButton android:id="@+id/player_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="上一个已缓存或下载的视频" android:src="@drawable/ic_player_previous_file"/><ImageButton android:id="@+id/player_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="下一个已缓存视频" android:src="@drawable/exo_icon_next"/><TextView android:id="@+id/player_quality" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center" android:text="画质" android:contentDescription="画质设置" android:clickable="true" android:focusable="true" android:importantForAccessibility="yes" android:textSize="11sp" android:textColor="#FFFFFF"/><ImageButton android:id="@+id/player_tracks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="音轨与字幕" android:src="@drawable/ic_player_tracks" android:tint="#FFFFFF"/>
<TextView android:id="@+id/player_speed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center" android:text="1.0×" android:textColor="#FFFFFF" android:textSize="13sp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="播放倍速" android:clickable="true" android:focusable="true"/>
<ImageButton android:id="@+id/player_files" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="切换视频" android:src="@drawable/ic_player_playlist"/><ImageButton android:id="@+id/player_pip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="悬浮播放" android:src="@drawable/ic_player_pip"/><ImageButton android:id="@+id/player_fullscreen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="全屏播放" android:src="@drawable/ic_player_fullscreen"/></LinearLayout></LinearLayout></FrameLayout>
